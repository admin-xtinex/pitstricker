--- !u!114 &1780916443
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1780916441}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.92, g: 0.94, b: 0.98, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 18
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "\u2605 1. TOSS PHASE (\u0D06\u0D26\u0D4D\u0D2F\u0D02 \u0D15\u0D41\u0D34\u0D3F\u0D2F\u0D3F\u0D32\u0D47\u0D15\u0D4D\u0D15\u0D4D \u0D0E\u0D31\u0D3F\u0D2F\u0D41\u0D15):\n   Players swipe forward to flick towards Pit 3. The marble closest to Pit 3 plays first!\n\n\u2605 2. THE THREE PITS (1 -> 2 -> 3):\n   You must sink your marble into Pit 1, then Pit 2, and finally Pit 3 in sequence.\n\n\u2605 3. BONUS EXTRA PLAYS (\u0D0E\u0D15\u0D4D\u0D38\u0D4D\u0D1F\u0D4D\u0D30\u0D3E \u0D2A\u0D4D\u0D32\u0D47):\n   - Sinking your target pit awards an Extra Shot!\n   - Striking an opponent's marble with yours awards a Tactical Extra Shot!\n\n\u2605 4. 3-SHOT CAP PER ROUND:\n   A player can take a maximum of 3 shots in one turn. Turn rotates on shot 3!\n\n\u2605 5. VICTORY:\n   The first player to conquer Pit 3 wins the match!"
