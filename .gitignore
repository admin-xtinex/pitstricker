# ==========================================
# Pit Striker — Universal Unity & Repository .gitignore
# ==========================================

# Unity generated directories & files
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Bb]uild/
**/[Bb]uilds/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/
**/[Mm]emoryCaptures/
**/[Uu]pmCache/
**/Assets/Plugins/Editor/JetBrains*
**/Assets/AssetStoreTools*

# Autogenerated Visual Studio / VS Code / Rider files
.vs/
.idea/
.vscode/
*.csproj
!Server/**/*.csproj
*.unityproj
*.sln
!Server/**/*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash reports & traces
sysinfo.txt
*.stackdump

# Builds output directory
/Builds/
*.apk
*.aab
*.symbols.zip

# OS Generated files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Crashlytics
crashlytics-build.properties

# Local capture and Python generation artifacts
__pycache__/
*.pyc
*.blend1
pitstricker/screenshot_*.png

# Server build outputs
Server/**/bin/
Server/**/obj/
Server/publish_linux/
Server/*.zip

pitstricker/emulator_*.png
pitstricker/*.log
*.log
**/.utmp/
